// https://deepswe.datacurve.ai/
// https://arcprize.org/leaderboard
// https://venturebeat.com/

{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": true,

  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

  "instructions": ["CODING.md"],

  "mcp": {
    // Z.AI Vision MCP — GLM-4.6V vision tools (image/video analysis, OCR, UI->code, etc.)
    // Docs: https://docs.z.ai/devpack/mcp/vision-mcp-server
    // Key read from the launcher environment via {env:} interpolation so it is never committed.
    "zai-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server@latest"],
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI",
      },
      "timeout": 300000,
    },
  },

  "agent": {
    "superpowers-glm-5.2": {
      "mode": "primary",
      "model": "zai-coding-plan/glm-5.2",
      "reasoningEffort": "high",
      "temperature": 0.5,
      "textVerbosity": "low",
      "reasoningSummary": "concise",
      //"prompt": "{file:./prompts/superpowers.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "task": "allow",
      },
      "tools": {
        "zai-mcp-server_*": true,
      },
    },

    "superpowers-mimo-2.5-pro": {
      //"disable": true,
      "mode": "primary",
      "model": "openrouter/xiaomi/mimo-v2.5-pro",
      "provider": { "only": ["xiaomi/fp8"], "allow_fallbacks": false },
      "temperature": 0.5,
      "textVerbosity": "low",
      "reasoningSummary": "concise",
      //"prompt": "{file:./prompts/superpowers.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "task": "allow",
      },
    },

    "plan": {
      "disable": true,
    },

    "build": {
      "disable": true,
    },
  },
}
